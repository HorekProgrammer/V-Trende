# Configuration for the Wordstat client.
WORDSTAT_SESSION_ID=

# VK Music chart. Проще всего: python -m parser.vk.login — вход в окне браузера,
# cookies сохранятся сами. Поля ниже нужны, только если хотите задать их вручную
# (copy only these cookie values from an authenticated vk.ru request).
VK_USER_ID=
VK_REMIXSID=
VK_REMIXNSID=
VK_USER_AGENT=
# Optional authenticated HTTP(S) proxy used only for VK Music requests.
VK_PROXY=

# Сохранение чартов (флаг --save). Пока BACKEND_URL пуст, данные пишутся в data/outbox/.
BACKEND_URL=
INTERNAL_API_TOKEN=

# Circuit breaker for external chart providers. State survives scheduled process restarts.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=300
CIRCUIT_BREAKER_STATE_FILE=data/circuit_breakers.json

# Twitch channel classification. Confirmed people and studios are stored permanently;
# DeepSeek is called again only for new or still-unknown channel names.
DEEPSEEK_API=
DEEPSEEK_MODEL=deepseek-flash
TWITCH_CLASSIFICATION_CACHE_FILE=data/cache/twitch/channel_types.json
TWITCH_CLASSIFICATION_BATCH_SIZE=10
TWITCH_PERSON_CONFIDENCE=0.75
# Optional authenticated HTTP(S) proxy for TwitchTracker. DeepSeek Fetch remains the fallback.
TWITCHTRACKER_PROXY=

# Web API. Несколько адресов перечисляются через запятую.
CORS_ORIGINS=http://localhost:5173

# PostgreSQL: рабочая база (миграции, загрузка, Wordstat).
DATABASE_URL=postgresql://postgres:password@localhost:5432/vtrende
# Отдельная база для тестов. ВНИМАНИЕ: тесты удаляют в ней все данные.
TEST_DATABASE_URL=
